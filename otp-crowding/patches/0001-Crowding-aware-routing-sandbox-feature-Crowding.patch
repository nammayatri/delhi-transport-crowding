+++ b/src/ext-test/java/org/opentripplanner/ext/crowding/CrowdingCostCalculatorTest.java
@@ -0,0 +1,128 @@
+package org.opentripplanner.ext.crowding;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.zip.GZIPOutputStream;
+import org.junit.jupiter.api.Test;
+import org.opentripplanner.raptor._data.transit.TestTripPattern;
+import org.opentripplanner.raptor._data.transit.TestTripSchedule;
+import org.opentripplanner.routing.algorithm.raptoradapter.transit.cost.DefaultCostCalculator;
+
+class CrowdingCostCalculatorTest {
+
+  // Stops 1..4; the middle stretch (position 1 -> 2) is crowded and adds 600 s of crowding.
+  private static final TestTripSchedule TRIP = TestTripSchedule
+    .schedule(TestTripPattern.pattern(1, 2, 3, 4))
+    .times("10:00 10:10 10:20 10:30")
+    .build();
+  private static final CrowdingIndex.Entry ENTRY = new CrowdingIndex.Entry(
+    new int[] { 0, 0, 600, 600 },
+    new byte[] { 0, 2, 0 }
+  );
+  private static final DefaultCostCalculator<TestTripSchedule> BASE = new DefaultCostCalculator<>(
+    60,
+    0,
+    1.0,
+    null,
+    null
+  );
+  private static final CrowdingCostCalculator<TestTripSchedule> SUBJECT = new CrowdingCostCalculator<>(
+    BASE,
+    1.5,
+    t -> ENTRY
+  );
+
+  private static int ride(DefaultCostCalculator<TestTripSchedule> unused, int board, int alight) {
+    return TRIP.arrival(alight) - TRIP.departure(board);
+  }
+
+  @Test
+  void crowdedMiddleStretchAddsReluctanceTimesExtraSeconds() {
+    int t = ride(BASE, 0, 3);
+    int base = BASE.transitArrivalCost(0, 0, t, TRIP, 4);
+    int withCrowding = SUBJECT.transitArrivalCost(0, 0, t, TRIP, 4);
+    assertEquals(base + 100 * 900, withCrowding);
+  }
+
+  @Test
+  void boardingAfterTheCrowdedStretchCostsNothingExtra() {
+    int t = ride(BASE, 2, 3);
+    assertEquals(
+      BASE.transitArrivalCost(0, 0, t, TRIP, 4),
+      SUBJECT.transitArrivalCost(0, 0, t, TRIP, 4)
+    );
+  }
+
+  @Test
+  void relativeRidingCostCountsCrowdingDownstreamOfBoarding() {
+    int before = TRIP.departure(0);
+    int after = TRIP.departure(2);
+    assertEquals(
+      BASE.onTripRelativeRidingCost(before, TRIP) + 100 * 900,
+      SUBJECT.onTripRelativeRidingCost(before, TRIP)
+    );
+    assertEquals(
+      BASE.onTripRelativeRidingCost(after, TRIP),
+      SUBJECT.onTripRelativeRidingCost(after, TRIP)
+    );
+  }
+
+  @Test
+  void lowerBoundIsUnchangedSoHeuristicsStayAdmissible() {
+    assertEquals(BASE.calculateMinCost(1200, 1), SUBJECT.calculateMinCost(1200, 1));
+  }
+
+  @Test
+  void missingOrMismatchedEntryFallsBackToDelegate() {
+    var none = new CrowdingCostCalculator<TestTripSchedule>(BASE, 1.5, t -> null);
+    var wrong = new CrowdingCostCalculator<TestTripSchedule>(
+      BASE,
+      1.5,
+      t -> new CrowdingIndex.Entry(new int[] { 0, 900 }, new byte[] { 2 })
+    );
+    int t = ride(BASE, 0, 3);
+    int base = BASE.transitArrivalCost(0, 0, t, TRIP, 4);
+    assertEquals(base, none.transitArrivalCost(0, 0, t, TRIP, 4));
+    assertEquals(base, wrong.transitArrivalCost(0, 0, t, TRIP, 4));
+  }
+
+  @Test
+  void readsTheBinaryIndex() throws Exception {
+    var bytes = new ByteArrayOutputStream();
+    try (var out = new DataOutputStream(new GZIPOutputStream(bytes))) {
+      out.write("CRWD".getBytes(StandardCharsets.US_ASCII));
+      out.writeShort(1);
+      out.writeShort(0);
+      out.writeInt(20261028);
+      out.writeLong(1_800_000_000L);
+      out.writeInt(1);
+      byte[] id = "142_12_50".getBytes(StandardCharsets.UTF_8);
+      out.writeShort(id.length);
+      out.write(id);
+      out.writeShort(3);
+      out.writeInt(0);
+      out.writeInt(0);
+      out.writeInt(420);
+      out.write(new byte[] { 0, 2 });
+    }
+    var idx = CrowdingIndex.read(new ByteArrayInputStream(bytes.toByteArray()));
+    assertEquals(
+      20261028,
+      idx.serviceDate().getYear() *
+      10000 +
+      idx.serviceDate().getMonthValue() *
+      100 +
+      idx.serviceDate().getDayOfMonth()
+    );
+    var e = idx.get("142_12_50");
+    assertEquals(420, e.extraSeconds(0, 2));
+    assertEquals(2, e.level(1));
+    assertEquals(CrowdingIndex.NO_DATA, e.level(5));
+    assertTrue(idx.size() == 1);
+  }
+}
diff --git a/src/ext/java/org/opentripplanner/ext/crowding/CrowdingCostCalculator.java b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingCostCalculator.java
new file mode 100644
index 0000000..e755c09
--- /dev/null
+++ b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingCostCalculator.java
@@ -0,0 +1,147 @@
+package org.opentripplanner.ext.crowding;
+
+import java.util.function.Function;
+import org.opentripplanner.raptor.api.model.RaptorAccessEgress;
+import org.opentripplanner.raptor.api.model.RaptorTransferConstraint;
+import org.opentripplanner.raptor.api.model.RaptorTripSchedule;
+import org.opentripplanner.raptor.spi.RaptorCostCalculator;
+import org.opentripplanner.routing.algorithm.raptoradapter.transit.TripSchedule;
+import org.opentripplanner.routing.algorithm.raptoradapter.transit.cost.DefaultTripSchedule;
+
+/**
+ * Adds a crowding cost to the generalized cost of every ride:
+ * {@code reluctance x (C[alight] - C[board])}, where {@code C} is the trip's cumulative
+ * crowding-extra seconds from the {@link CrowdingIndex}. The extra cost is never negative, so
+ * {@link #calculateMinCost} stays a valid lower bound and the RAPTOR heuristics remain
+ * admissible.
+ * <p>
+ * Board and alight positions are recovered from the trip schedule: RAPTOR passes the alight stop
+ * and the ride time, and both board and alight times are schedule times of the same trip.
+ */
+public final class CrowdingCostCalculator<T extends DefaultTripSchedule>
+  implements RaptorCostCalculator<T> {
+
+  private final RaptorCostCalculator<T> delegate;
+  /** Raptor cost units are centi-seconds. */
+  private final double centiReluctance;
+  private final Function<T, CrowdingIndex.Entry> lookup;
+
+  public CrowdingCostCalculator(RaptorCostCalculator<T> delegate, double reluctance) {
+    this(delegate, reluctance, CrowdingCostCalculator::indexEntry);
+  }
+
+  /** With an explicit lookup, for tests. */
+  CrowdingCostCalculator(
+    RaptorCostCalculator<T> delegate,
+    double reluctance,
+    Function<T, CrowdingIndex.Entry> lookup
+  ) {
+    this.delegate = delegate;
+    this.centiReluctance = reluctance * 100.0;
+    this.lookup = lookup;
+  }
+
+  @Override
+  public int boardingCost(
+    boolean firstBoarding,
+    int prevArrivalTime,
+    int boardStop,
+    int boardTime,
+    T trip,
+    RaptorTransferConstraint transferConstraints
+  ) {
+    return delegate.boardingCost(
+      firstBoarding,
+      prevArrivalTime,
+      boardStop,
+      boardTime,
+      trip,
+      transferConstraints
+    );
+  }
+
+  /**
+   * Rides boarded on the same pattern at the same stop are compared on this relative cost. We add
+   * the crowding from the boarding position to the end of the trip, so of two trips the one that
+   * is less crowded downstream compares better.
+   */
+  @Override
+  public int onTripRelativeRidingCost(int boardTime, T trip) {
+    int base = delegate.onTripRelativeRidingCost(boardTime, trip);
+    var e = lookup.apply(trip);
+    if (e == null || e.numberOfStops() != trip.pattern().numberOfStopsInPattern()) {
+      return base;
+    }
+    int n = trip.pattern().numberOfStopsInPattern();
+    int b = boardPosition(trip, boardTime, n - 2);
+    if (b < 0) {
+      return base;
+    }
+    return base + cost(e.extraSeconds(b, n - 1));
+  }
+
+  @Override
+  public int transitArrivalCost(
+    int boardCost,
+    int alightSlack,
+    int transitTime,
+    T trip,
+    int toStop
+  ) {
+    int base = delegate.transitArrivalCost(boardCost, alightSlack, transitTime, trip, toStop);
+    var e = lookup.apply(trip);
+    if (e == null || e.numberOfStops() != trip.pattern().numberOfStopsInPattern()) {
+      return base;
+    }
+    var pattern = trip.pattern();
+    for (int a = pattern.numberOfStopsInPattern() - 1; a > 0; a--) {
+      if (pattern.stopIndex(a) != toStop) {
+        continue;
+      }
+      int b = boardPosition(trip, trip.arrival(a) - transitTime, a - 1);
+      if (b >= 0) {
+        return base + cost(e.extraSeconds(b, a));
+      }
+    }
+    return base;
+  }
+
+  @Override
+  public int waitCost(int waitTimeInSeconds) {
+    return delegate.waitCost(waitTimeInSeconds);
+  }
+
+  @Override
+  public int calculateMinCost(int minTravelTime, int minNumTransfers) {
+    return delegate.calculateMinCost(minTravelTime, minNumTransfers);
+  }
+
+  @Override
+  public int costEgress(RaptorAccessEgress egress) {
+    return delegate.costEgress(egress);
+  }
+
+  private int cost(int extraSeconds) {
+    return extraSeconds <= 0 ? 0 : (int) Math.round(centiReluctance * extraSeconds);
+  }
+
+  private static int boardPosition(RaptorTripSchedule trip, int boardTime, int maxPos) {
+    for (int p = maxPos; p >= 0; p--) {
+      if (trip.departure(p) == boardTime) {
+        return p;
+      }
+    }
+    return -1;
+  }
+
+  private static CrowdingIndex.Entry indexEntry(DefaultTripSchedule trip) {
+    if (!(trip instanceof TripSchedule ts)) {
+      return null;
+    }
+    var idx = CrowdingIndexService.peek(ts.getServiceDate());
+    if (idx == null) {
+      return null;
+    }
+    return idx.get(ts.getOriginalTripTimes().getTrip().getId().getId());
+  }
+}
diff --git a/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndex.java b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndex.java
new file mode 100644
index 0000000..9365fa6
--- /dev/null
+++ b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndex.java
@@ -0,0 +1,101 @@
+package org.opentripplanner.ext.crowding;
+
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.zip.GZIPInputStream;
+
+/**
+ * Crowding for every trip running on one service date, as published by the crowding service
+ * ({@code GET /v1/otp/crowding-index?date=YYYY-MM-DD}).
+ * <p>
+ * For each trip it holds the cumulative crowding-extra seconds at each stop position,
+ * {@code C[0] = 0, C[k+1] = C[k] + rideTime(k) * (multiplier(k) - 1)}, so riding from position
+ * {@code i} to {@code j} costs {@code C[j] - C[i]} extra seconds, and the commuter level of each
+ * segment. Instances are immutable and swapped atomically by {@link CrowdingIndexService}.
+ */
+public final class CrowdingIndex {
+
+  public static final int NO_DATA = 255;
+  public static final String[] LEVELS = { "SEATS", "STANDING", "CROWDED" };
+
+  public record Entry(int[] cumulativeSeconds, byte[] levels) {
+    public int extraSeconds(int fromPos, int toPos) {
+      if (fromPos < 0 || toPos >= cumulativeSeconds.length || toPos <= fromPos) {
+        return 0;
+      }
+      return cumulativeSeconds[toPos] - cumulativeSeconds[fromPos];
+    }
+
+    public int level(int segment) {
+      return segment >= 0 && segment < levels.length ? levels[segment] & 0xff : NO_DATA;
+    }
+
+    public int numberOfStops() {
+      return cumulativeSeconds.length;
+    }
+  }
+
+  private final LocalDate serviceDate;
+  private final Instant generatedAt;
+  private final Map<String, Entry> trips;
+
+  private CrowdingIndex(LocalDate serviceDate, Instant generatedAt, Map<String, Entry> trips) {
+    this.serviceDate = serviceDate;
+    this.generatedAt = generatedAt;
+    this.trips = trips;
+  }
+
+  public LocalDate serviceDate() {
+    return serviceDate;
+  }
+
+  public Instant generatedAt() {
+    return generatedAt;
+  }
+
+  public int size() {
+    return trips.size();
+  }
+
+  /** Crowding for a trip, by its GTFS trip id (without feed prefix), or null. */
+  public Entry get(String tripId) {
+    return trips.get(tripId);
+  }
+
+  /** Parse the gzip-compressed binary format (version 1). */
+  public static CrowdingIndex read(InputStream gzipped) throws IOException {
+    try (var in = new DataInputStream(new GZIPInputStream(gzipped, 1 << 16))) {
+      byte[] magic = in.readNBytes(4);
+      if (!"CRWD".equals(new String(magic, StandardCharsets.US_ASCII))) {
+        throw new IOException("Not a crowding index");
+      }
+      int version = in.readUnsignedShort();
+      if (version != 1) {
+        throw new IOException("Unsupported crowding index version " + version);
+      }
+      in.readUnsignedShort();
+      int ymd = in.readInt();
+      var date = LocalDate.of(ymd / 10000, (ymd / 100) % 100, ymd % 100);
+      var generated = Instant.ofEpochSecond(in.readLong());
+      int n = in.readInt();
+      var map = new HashMap<String, Entry>(n * 2);
+      for (int i = 0; i < n; i++) {
+        String id = new String(in.readNBytes(in.readUnsignedShort()), StandardCharsets.UTF_8);
+        int stops = in.readUnsignedShort();
+        int[] cum = new int[stops];
+        for (int k = 0; k < stops; k++) {
+          cum[k] = in.readInt();
+        }
+        byte[] levels = in.readNBytes(Math.max(0, stops - 1));
+        map.put(id, new Entry(cum, levels));
+      }
+      return new CrowdingIndex(date, generated, Map.copyOf(map));
+    }
+  }
+}
diff --git a/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndexService.java b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndexService.java
new file mode 100644
index 0000000..ffa5000
--- /dev/null
+++ b/src/ext/java/org/opentripplanner/ext/crowding/CrowdingIndexService.java
@@ -0,0 +1,127 @@
+package org.opentripplanner.ext.crowding;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Keeps one {@link CrowdingIndex} per service date, fetched from the crowding service and
+ * refreshed in the background. Routing never waits on the network inside the search: the cost
+ * calculator only {@link #peek}s; the request mapper calls {@link #ensureLoaded} once per request
+ * so the search date is present.
+ * <p>
+ * Configured with environment variables:
+ * <ul>
+ *   <li>{@code OTP_CROWDING_INDEX_URL} (default {@code http://localhost:8090/v1/otp/crowding-index})</li>
+ *   <li>{@code OTP_CROWDING_REFRESH_SECONDS} (default 300): live adjustments arrive this often</li>
+ *   <li>{@code OTP_CROWDING_TIMEZONE} (default {@code Asia/Kolkata}): zone of service dates</li>
+ * </ul>
+ */
+public final class CrowdingIndexService {
+
+  private static final Logger LOG = LoggerFactory.getLogger(CrowdingIndexService.class);
+
+  private static final String URL = env(
+    "OTP_CROWDING_INDEX_URL",
+    "http://localhost:8090/v1/otp/crowding-index"
+  );
+  private static final Duration REFRESH = Duration.ofSeconds(
+    Long.parseLong(env("OTP_CROWDING_REFRESH_SECONDS", "300"))
+  );
+  public static final ZoneId ZONE = ZoneId.of(env("OTP_CROWDING_TIMEZONE", "Asia/Kolkata"));
+
+  private record Holder(CrowdingIndex index, Instant fetched) {}
+
+  private static final ConcurrentHashMap<LocalDate, Holder> CACHE = new ConcurrentHashMap<>();
+  private static final ConcurrentHashMap<LocalDate, Boolean> REFRESHING = new ConcurrentHashMap<>();
+  private static final ExecutorService EXECUTOR = Executors.newSingleThreadExecutor(r -> {
+    var t = new Thread(r, "crowding-index-refresh");
+    t.setDaemon(true);
+    return t;
+  });
+  private static final HttpClient HTTP = HttpClient
+    .newBuilder()
+    .connectTimeout(Duration.ofSeconds(5))
+    .build();
+
+  private CrowdingIndexService() {}
+
+  private static String env(String key, String fallback) {
+    String v = System.getenv(key);
+    return v == null || v.isBlank() ? fallback : v;
+  }
+
+  /** The index for a date if already loaded; schedules a refresh when stale. Never blocks. */
+  public static CrowdingIndex peek(LocalDate date) {
+    var h = CACHE.get(date);
+    if (h == null) {
+      return null;
+    }
+    if (h.fetched.plus(REFRESH).isBefore(Instant.now())) {
+      refreshAsync(date);
+    }
+    return h.index;
+  }
+
+  /** Load the index for a date if missing (blocking, bounded by the HTTP timeout). */
+  public static CrowdingIndex ensureLoaded(LocalDate date) {
+    var idx = peek(date);
+    if (idx != null) {
+      return idx;
+    }
+    synchronized (CrowdingIndexService.class) {
+      var h = CACHE.get(date);
+      if (h != null) {
+        return h.index;
+      }
+      return fetch(date);
+    }
+  }
+
+  private static void refreshAsync(LocalDate date) {
+    if (REFRESHING.putIfAbsent(date, Boolean.TRUE) == null) {
+      EXECUTOR.submit(() -> {
+        try {
+          fetch(date);
+        } finally {
+          REFRESHING.remove(date);
+        }
+      });
+    }
+  }
+
+  private static CrowdingIndex fetch(LocalDate date) {
+    try {
+      var req = HttpRequest
+        .newBuilder(URI.create(URL + (URL.contains("?") ? "&" : "?") + "date=" + date))
+        .timeout(Duration.ofSeconds(20))
+        .GET()
+        .build();
+      var resp = HTTP.send(req, HttpResponse.BodyHandlers.ofInputStream());
+      if (resp.statusCode() != 200) {
+        LOG.warn("Crowding index for {}: HTTP {}", date, resp.statusCode());
+        return null;
+      }
+      var idx = CrowdingIndex.read(resp.body());
+      CACHE.put(date, new Holder(idx, Instant.now()));
+      if (CACHE.size() > 8) {
+        CACHE.keySet().stream().sorted().limit(CACHE.size() - 8L).toList().forEach(CACHE::remove);
+      }
+      LOG.info("Crowding index for {} loaded: {} trips", date, idx.size());
+      return idx;
+    } catch (Exception e) {
+      LOG.warn("Crowding index for {} unavailable: {}", date, e.toString());
+      return null;
+    }
+  }
+}
diff --git a/src/ext/java/org/opentripplanner/ext/crowding/LegCrowdingMapper.java b/src/ext/java/org/opentripplanner/ext/crowding/LegCrowdingMapper.java
new file mode 100644
index 0000000..f554f59
--- /dev/null
+++ b/src/ext/java/org/opentripplanner/ext/crowding/LegCrowdingMapper.java
@@ -0,0 +1,71 @@
+package org.opentripplanner.ext.crowding;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.opentripplanner.model.plan.Leg;
+import org.opentripplanner.model.plan.ScheduledTransitLeg;
+
+/** Builds the GraphQL {@code Leg.crowding} value for a scheduled transit leg. */
+public final class LegCrowdingMapper {
+
+  private LegCrowdingMapper() {}
+
+  public static Map<String, Object> map(Leg leg) {
+    if (!(leg instanceof ScheduledTransitLeg st) || st.getBoardStopPosInPattern() == null) {
+      return null;
+    }
+    var idx = CrowdingIndexService.ensureLoaded(st.getServiceDate());
+    if (idx == null) {
+      return null;
+    }
+    var e = idx.get(st.getTrip().getId().getId());
+    var pattern = st.getTripPattern();
+    if (e == null || e.numberOfStops() != pattern.numberOfStops()) {
+      return null;
+    }
+    int b = st.getBoardStopPosInPattern();
+    int a = st.getAlightStopPosInPattern();
+    List<Map<String, Object>> segments = new ArrayList<>();
+    int worst = -1;
+    for (int k = b; k < a; k++) {
+      int lvl = e.level(k);
+      var seg = new LinkedHashMap<String, Object>();
+      seg.put("fromStop", pattern.getStop(k).getName().toString());
+      seg.put("toStop", pattern.getStop(k + 1).getName().toString());
+      seg.put("level", lvl == CrowdingIndex.NO_DATA ? null : CrowdingIndex.LEVELS[lvl]);
+      segments.add(seg);
+      if (lvl != CrowdingIndex.NO_DATA) {
+        worst = Math.max(worst, lvl);
+      }
+    }
+    // Longest run of segments at the worst level.
+    int bestStart = -1, bestLen = 0, runStart = -1;
+    for (int k = b; k < a; k++) {
+      if (worst >= 0 && e.level(k) == worst) {
+        if (runStart < 0) {
+          runStart = k;
+        }
+        if (k - runStart + 1 > bestLen) {
+          bestLen = k - runStart + 1;
+          bestStart = runStart;
+        }
+      } else {
+        runStart = -1;
+      }
+    }
+    var out = new LinkedHashMap<String, Object>();
+    int first = e.level(b);
+    out.put("levelAtBoarding", first == CrowdingIndex.NO_DATA ? null : CrowdingIndex.LEVELS[first]);
+    out.put("worstLevel", worst < 0 ? null : CrowdingIndex.LEVELS[worst]);
+    out.put("worstFrom", bestStart < 0 ? null : pattern.getStop(bestStart).getName().toString());
+    out.put(
+      "worstTo",
+      bestStart < 0 ? null : pattern.getStop(bestStart + bestLen).getName().toString()
+    );
+    out.put("crowdingExtraSeconds", e.extraSeconds(b, a));
+    out.put("segments", segments);
+    return out;
+  }
+}
